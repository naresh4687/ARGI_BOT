# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
# LLM provider: offline | openai_compatible | ollama
#   offline           - no AI generation; shows retrieved passages (clearly labelled)
#   openai_compatible - any hosted API with the OpenAI /chat/completions format
#   ollama            - local Ollama server
LLM_PROVIDER=offline

# Hosted provider (openai_compatible). Examples - check the provider's current
# model list and free-tier quota before use; quotas change and are not unlimited.
#   Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1
#   Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your-api-key-here

# Local Ollama (ollama serve; ollama pull gemma3:4b). Free, offline, no key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192            # context window; prompts beyond this are silently truncated
OLLAMA_TIMEOUT_SECONDS=300     # CPU-only generation can take a while

# Request behaviour
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700

# Retrieval (defaults were chosen from evaluation/results; change with care)
# TOP_K=4
# DENSE_WEIGHT_EN=0.5
# DENSE_WEIGHT_TA=0.2
# MIN_RELEVANCE_EN=0.25
# MIN_RELEVANCE_TA=0.18
# RELATIVE_CUTOFF=0.85
# CHUNK_SIZE=400
# CHUNK_SIZE_TA=300
# CHUNK_OVERLAP=70
# MAX_QUESTION_CHARS=1000
# AUTO_FETCH_SOURCES=0   # 1 = download data/raw/ from the manifest if it is empty
