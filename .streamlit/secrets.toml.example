# Streamlit Community Cloud: paste these into App settings -> Secrets.
# Locally you may copy this file to .streamlit/secrets.toml (git-ignored).
LLM_PROVIDER = "openai_compatible"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-120b"   # check the provider's current model list
LLM_API_KEY = "your-api-key-here"
# The repository has no source documents; download them on first boot.
AUTO_FETCH_SOURCES = "1"
